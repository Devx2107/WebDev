    {
      "id": "c1HKM2pzHGdzFaZu9kF0r",
      "type": "text",
      "x": -1954.905989936954,
      "y": 8693.175803212373,
      "width": 1974.7756853814142,
      "height": 250.86090355422303,
      "angle": 0,
