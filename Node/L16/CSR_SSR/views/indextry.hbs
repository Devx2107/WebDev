<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>Todo app</h1>
    {{!-- Create --}}
    <form action="/todos" method = "POST">
        <input type="text" name="name" placeholder="Enter task">
        <button type="submit">Add Todo</button>
    </form>
    <ul id = "task">
        {{#each todos as |t|}}
        <li>
            <span>{{t}}</span>
        {{!-- Update --}}
        <form action="/todos/update" method="post" style="display:inline">
            <input type="text" name="newName" placeholder="Edit">
            <input type="hidden" name="index" value="{{@index}}">
            <button type = "submit">Update</button>
        </form>
        {{!-- Delete --}}
        <form action="/todos/delete" method="post" style="display:inline">
        <input type="hidden" name="index" value="{{@index}}">
        <button type = "submit">Delete</button>
        </form>
        </li>
        {{#each}}

    </ul> 
</body>
</html>